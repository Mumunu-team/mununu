# Rust
/target/
**/target/
# CI's bind-mounted cargo target (rust-cache), see .github/workflows/ci.yml
/.ci-target/
*.pdb

# Machine-local cargo build config (lld linker path, optional sccache) —
# host-specific (Homebrew lld path, Intel vs Apple Silicon), never committed.
.cargo/config.toml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files
*.env
.env

# Secrets / credentials
# Block common file types that hold private keys, certificates, and tokens.
# If a legitimate fixture trips one of these, allow-list it explicitly with `!path/to/fixture`.
*.key
*.pem
*.p12
*.pfx
*.crt
*.gpg
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*credentials*.json
*service-account*.json
secrets.toml
.secrets/

# Logs
*.log
/logs/

# Test artifacts
/tmp/
/test_output/
bench_results/
/.mununu_dsl_debug/

# Generated verify-example build output (CEGAR run artifacts, etc.)
examples/verify/**/build/

# Reproducible-experiments scaffold: target/test-fixtures/ holds canonical
# CLTS fixtures rebuilt from seeds, and per-EXP bench stdout is captured
# alongside the criterion archive but the live run log shouldn't be tracked.
**/bench-stdout.log
.repro-EXP-*/

# Documentation build
/doc/

# Claude Code (user-local)
.claude/settings.json
.claude/reviews/
.claude/plans/
.claude/scheduled_tasks.lock

# Debug traces
.z3-trace

# Python bytecode
**/__pycache__/

# Quality session artifacts
/.quality/sessions/

# Private / unpublished material (lives in mununu-private/)
/paper/
/artifact/
/examples/syntcomp/
/examples/scalable/
/tutorial/

# Local experiment area — BTOR2 dumps, probe scripts, vendor stubs, ledger runs.
# Untracked by design: it is a working surface, not a deliverable. Committed once
# by a `git add -A` that swept it in; the `--cached` removal left every file on
# disk untouched.
scratchpad/
