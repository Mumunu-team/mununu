{
  "version": "1.0",
  "templates": [
    {
      "id": "no_deadlock",
      "display_name": "No Deadlock",
      "description": "Every reachable state has at least one enabled transition (no terminal states)",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [],
      "formula_pattern": "nu X. (<> true && [] X)",
      "domain_hints": {
        "rtl": {},
        "agentic": {},
        "software": {}
      },
      "tags": ["deadlock", "softlock", "safety", "liveness"]
    },
    {
      "id": "reachable",
      "display_name": "Reachable State",
      "description": "Target predicate is reachable from initial states",
      "kind": "liveness",
      "role": "standalone",
      "domains": ["universal"],
      "params": [
        {
          "name": "TARGET",
          "description": "Predicate that should be reachable",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "mu X. (${TARGET} || <> X)",
      "domain_hints": {
        "rtl": { "TARGET": "e.g., state_IDLE, fill_0" },
        "agentic": { "TARGET": "e.g., SessionClosed, Authenticated" },
        "software": { "TARGET": "e.g., Released, Disposed" }
      },
      "tags": ["reachability"]
    },
    {
      "id": "never",
      "display_name": "Never (Invariant)",
      "description": "A bad predicate never holds in any reachable state",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "BAD",
          "description": "Predicate that must never hold",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. (!${BAD} && [] X)",
      "domain_hints": {
        "rtl": { "BAD": "e.g., overflow, error_state" },
        "agentic": { "BAD": "e.g., Unauthorized, DataLeak" },
        "software": { "BAD": "e.g., NullState, Corrupted" }
      },
      "tags": ["safety", "invariant"]
    },
    {
      "id": "always_eventually",
      "display_name": "Always Eventually",
      "description": "Target is always eventually reached (GF pattern / recurrence)",
      "kind": "liveness",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "TARGET",
          "description": "Predicate that must be revisited infinitely often",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu Y. ((mu X. (${TARGET} || <> X)) && [] Y)",
      "domain_hints": {
        "rtl": { "TARGET": "e.g., state_IDLE (reset recovery)" },
        "agentic": { "TARGET": "e.g., Ready (session cleanup)" },
        "software": { "TARGET": "e.g., Available (resource release)" }
      },
      "tags": ["liveness", "recurrence", "return-to-idle"]
    },
    {
      "id": "bounded",
      "display_name": "Bounded Resource",
      "description": "Resource stays within bounds (never overflows or underflows)",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "OVERFLOW",
          "description": "Predicate for upper-bound violation",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "UNDERFLOW",
          "description": "Predicate for lower-bound violation",
          "param_type": { "type": "predicate" },
          "default": "false",
          "required": false
        }
      ],
      "formula_pattern": "nu X. (!${OVERFLOW} && !${UNDERFLOW} && [] X)",
      "domain_hints": {
        "rtl": { "OVERFLOW": "e.g., fill_5 (FIFO depth exceeded)", "UNDERFLOW": "e.g., fill_neg1" },
        "software": { "OVERFLOW": "e.g., count_max", "UNDERFLOW": "e.g., count_0" }
      },
      "tags": ["safety", "bounds", "resource"]
    },
    {
      "id": "response",
      "display_name": "Response (Request-Grant)",
      "description": "Every trigger is eventually followed by a response",
      "kind": "liveness",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "TRIGGER",
          "description": "Request/trigger predicate",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "RESPONSE",
          "description": "Expected response predicate",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. ((!${TRIGGER} || mu Y. (${RESPONSE} || <> Y)) && [] X)",
      "domain_hints": {
        "rtl": { "TRIGGER": "e.g., req_active", "RESPONSE": "e.g., ack_active" },
        "agentic": { "TRIGGER": "e.g., RequestReceived", "RESPONSE": "e.g., ResponseSent" }
      },
      "tags": ["liveness", "response", "handshake"]
    },
    {
      "id": "fair_response",
      "display_name": "Fair Response (under assumptions)",
      "description": "Every trigger is eventually followed by a response on every FAIR path — a path satisfying the property's declared `assumptions` (mununu#595). On the `verify` path the body is expanded from the `[[assumptions]]` the property lists (one fair-EG conjunct each; see `verify::fairness`) and the verdict is reported as conditional (`holds under …`) together with a non-vacuity gate. Shown here is the zero-assumption instance, AG(TRIGGER -> AF RESPONSE); `verify` refuses that spelling — use `response`.",
      "kind": "liveness",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "TRIGGER",
          "description": "Request/trigger predicate",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "RESPONSE",
          "description": "Expected response predicate",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "(nu W. ((!(${TRIGGER}) || !(nu Z. ((!(${RESPONSE})) && < > Z))) && [] W))",
      "domain_hints": {
        "rtl": { "TRIGGER": "e.g., req_active", "RESPONSE": "e.g., ack_active" },
        "agentic": { "TRIGGER": "e.g., RequestReceived", "RESPONSE": "e.g., ResponseSent" }
      },
      "tags": ["liveness", "response", "fairness", "assumptions"]
    },
    {
      "id": "fair_always_eventually",
      "display_name": "Fair Always Eventually (under assumptions)",
      "description": "From every reachable state, every FAIR path eventually reaches the target — a path satisfying the property's declared `assumptions` (mununu#595). On the `verify` path the body is expanded from the `[[assumptions]]` the property lists and the verdict is conditional (`holds under …`) with a non-vacuity gate. Shown here is the zero-assumption instance, AG AF TARGET; `verify` refuses that spelling — use `always_eventually` (note: that template is AG EF, the existential reading).",
      "kind": "liveness",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "TARGET",
          "description": "Predicate every fair path must keep reaching",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "(nu W. (!(nu Z. ((!(${TARGET})) && < > Z)) && [] W))",
      "domain_hints": {
        "rtl": { "TARGET": "e.g., state_IDLE (reset recovery under a fair environment)" },
        "agentic": { "TARGET": "e.g., Ready (session cleanup under a responsive peer)" }
      },
      "tags": ["liveness", "recurrence", "fairness", "assumptions"]
    },
    {
      "id": "mutual_exclusion",
      "display_name": "Mutual Exclusion",
      "description": "Two predicates never hold simultaneously",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "A",
          "description": "First exclusive predicate",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "B",
          "description": "Second exclusive predicate",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. (!(${A} && ${B}) && [] X)",
      "domain_hints": {
        "rtl": { "A": "e.g., grant_0", "B": "e.g., grant_1" },
        "agentic": { "A": "e.g., Agent1_Active", "B": "e.g., Agent2_Active" }
      },
      "tags": ["safety", "mutex", "exclusion"]
    },
    {
      "id": "label_blocked_in_state",
      "display_name": "Label Blocked in State",
      "description": "A specific label is impossible when a predicate holds",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "STATE",
          "description": "State predicate where the label should be blocked",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "LABEL",
          "description": "Label that must be impossible in that state",
          "param_type": { "type": "label" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. ((!${STATE} || [${LABEL}] false) && [] X)",
      "domain_hints": {
        "software": { "STATE": "e.g., Empty", "LABEL": "e.g., ev_get" },
        "rtl": { "STATE": "e.g., state_IDLE", "LABEL": "e.g., data_out" }
      },
      "tags": ["safety", "guard", "access-control"]
    },
    {
      "id": "no_clobber",
      "display_name": "No Clobber (Compositional)",
      "description": "A shared resource never enters a corrupt state under concurrent access. Pairs with `clobber_reachable` for a non-vacuous witness — always ship both together so a passing safety verdict isn't trivially satisfied by an empty model.",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["agentic", "universal"],
      "params": [
        {
          "name": "RESOURCE_CORRUPT",
          "description": "Predicate marking the corrupted state of the shared resource (typically a state name on the resource automaton).",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. (!${RESOURCE_CORRUPT} && [] X)",
      "domain_hints": {
        "agentic": { "RESOURCE_CORRUPT": "e.g., F_clobbered, T755_LLMReturnedContaminated" },
        "software": { "RESOURCE_CORRUPT": "e.g., FileCorrupted, Inconsistent" },
        "rtl": { "RESOURCE_CORRUPT": "e.g., bus_collision, state_undef" }
      },
      "tags": ["safety", "concurrency", "composition", "race"]
    },
    {
      "id": "clobber_reachable",
      "display_name": "Clobber Reachable (Witness)",
      "description": "Reachability witness for the corrupted-resource state. Always shipped alongside `no_clobber` to confirm the safety property isn't trivially satisfied by an empty model. A failing reachability check on a passing safety check signals an over-restrictive abstraction.",
      "kind": "liveness",
      "role": "standalone",
      "domains": ["agentic", "universal"],
      "params": [
        {
          "name": "RESOURCE_CORRUPT",
          "description": "The same predicate `no_clobber` checks against.",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "mu X. (${RESOURCE_CORRUPT} || <> X)",
      "domain_hints": {
        "agentic": { "RESOURCE_CORRUPT": "e.g., F_clobbered, T755_LLMReturnedContaminated" },
        "software": { "RESOURCE_CORRUPT": "e.g., FileCorrupted, Inconsistent" },
        "rtl": { "RESOURCE_CORRUPT": "e.g., bus_collision, state_undef" }
      },
      "tags": ["liveness", "reachability", "concurrency", "composition", "witness"]
    },
    {
      "id": "mutual_exclusion_3",
      "display_name": "Mutual Exclusion (3-way)",
      "description": "Three predicates are pairwise exclusive — at most one holds in any reachable state. Useful for compositions with three contending instances (e.g., three workers competing for one resource). The existing `mutual_exclusion` template covers the 2-way case.",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["universal"],
      "params": [
        {
          "name": "A",
          "description": "First exclusive predicate",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "B",
          "description": "Second exclusive predicate",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "C",
          "description": "Third exclusive predicate",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. (!(${A} && ${B}) && !(${A} && ${C}) && !(${B} && ${C}) && [] X)",
      "domain_hints": {
        "agentic": { "A": "e.g., WorkerA_Holds", "B": "e.g., WorkerB_Holds", "C": "e.g., WorkerC_Holds" },
        "rtl": { "A": "e.g., grant_0", "B": "e.g., grant_1", "C": "e.g., grant_2" },
        "software": { "A": "e.g., LockedByA", "B": "e.g., LockedByB", "C": "e.g., LockedByC" }
      },
      "tags": ["safety", "mutex", "exclusion", "concurrency", "composition"]
    },
    {
      "id": "bounded_handoff",
      "display_name": "Bounded Handoff",
      "description": "Once a handoff is triggered, completion is reachable from there in finite steps. Maps to MCP-001's parallel-interrupt resume pattern (after the resume request, the resume must eventually take effect).",
      "kind": "liveness",
      "role": "guarantee",
      "domains": ["agentic", "universal"],
      "params": [
        {
          "name": "HANDOFF_TRIGGERED",
          "description": "Predicate marking the handoff/resume request.",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "HANDOFF_COMPLETE",
          "description": "Predicate marking the handoff/resume completion.",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. ((!${HANDOFF_TRIGGERED} || mu Y. (${HANDOFF_COMPLETE} || <> Y)) && [] X)",
      "domain_hints": {
        "agentic": { "HANDOFF_TRIGGERED": "e.g., A_ResumeRequested", "HANDOFF_COMPLETE": "e.g., A_ResumeApplied" },
        "rtl": { "HANDOFF_TRIGGERED": "e.g., req_active", "HANDOFF_COMPLETE": "e.g., grant_active" },
        "software": { "HANDOFF_TRIGGERED": "e.g., TaskQueued", "HANDOFF_COMPLETE": "e.g., TaskExecuted" }
      },
      "tags": ["liveness", "handoff", "concurrency", "composition", "response"]
    },
    {
      "id": "no_lost_update",
      "display_name": "No Lost Update",
      "description": "Every started write becomes externally visible — no overwrite suppresses an in-flight update. Direct match for MCP-002's contamination patterns (a write that's started must commit before another write supersedes it).",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["agentic", "universal"],
      "params": [
        {
          "name": "WRITE_STARTED",
          "description": "Predicate marking that a write has been initiated by some component.",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "WRITE_VISIBLE",
          "description": "Predicate marking that the write's effect is observable in the shared resource (committed).",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. ((!${WRITE_STARTED} || ${WRITE_VISIBLE}) && [] X)",
      "domain_hints": {
        "agentic": { "WRITE_STARTED": "e.g., A_LoadV0, T755_Set", "WRITE_VISIBLE": "e.g., A_SaveCommitted, T755_Returned" },
        "software": { "WRITE_STARTED": "e.g., WriteIssued", "WRITE_VISIBLE": "e.g., WritePersisted" },
        "rtl": { "WRITE_STARTED": "e.g., wr_req", "WRITE_VISIBLE": "e.g., wr_ack" }
      },
      "tags": ["safety", "consistency", "concurrency", "composition", "atomicity"]
    },
    {
      "id": "no_delegation_cycle",
      "display_name": "No Delegation Cycle",
      "description": "Once a delegation from one agent to another has fired, the reverse delegation must never fire afterwards. Catches A->B->A handoff cycles (CrewAI hierarchical, LangGraph back-edges) that would loop indefinitely.",
      "kind": "safety",
      "role": "guarantee",
      "domains": ["agentic", "universal"],
      "params": [
        {
          "name": "FORWARD",
          "description": "Predicate marking the forward delegation (e.g., A delegated to B).",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "BACKWARD",
          "description": "Predicate marking the reverse delegation (e.g., B delegating back to A).",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. ((!${FORWARD} || nu Y. (!${BACKWARD} && [] Y)) && [] X)",
      "domain_hints": {
        "agentic": { "FORWARD": "e.g., Manager_Delegated_To_Worker", "BACKWARD": "e.g., Worker_Delegating_To_Manager" },
        "software": { "FORWARD": "e.g., Caller_Invoked_Callee", "BACKWARD": "e.g., Callee_Invoking_Caller" }
      },
      "tags": ["safety", "delegation", "cycle", "agentic", "hierarchical"]
    },
    {
      "id": "eventual_completion",
      "display_name": "Eventual Completion",
      "description": "Every started task / workflow eventually reaches a terminal state. Maps to LangGraph reachability of `END` from any task-start state, or CrewAI's expectation that every dispatched task completes.",
      "kind": "liveness",
      "role": "guarantee",
      "domains": ["agentic", "universal"],
      "params": [
        {
          "name": "TASK_STARTED",
          "description": "Predicate marking task dispatch / workflow entry.",
          "param_type": { "type": "predicate" },
          "required": true
        },
        {
          "name": "TASK_DONE",
          "description": "Predicate marking task termination (success or terminal failure).",
          "param_type": { "type": "predicate" },
          "required": true
        }
      ],
      "formula_pattern": "nu X. ((!${TASK_STARTED} || mu Y. (${TASK_DONE} || <> Y)) && [] X)",
      "domain_hints": {
        "agentic": { "TASK_STARTED": "e.g., Crew_Dispatched, Graph_Entered", "TASK_DONE": "e.g., Crew_Done, Graph_End" },
        "software": { "TASK_STARTED": "e.g., JobQueued", "TASK_DONE": "e.g., JobSettled" }
      },
      "tags": ["liveness", "completion", "agentic", "termination", "workflow"]
    }
  ]
}
