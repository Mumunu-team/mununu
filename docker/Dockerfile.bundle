# syntax=docker/dockerfile:1
# Roadmap H5 — the on-prem bundle image: the product binary, the SystemVerilog toolchain and the
# UI in ONE container on ONE port. Built by scripts/bundle.sh, shipped as a `docker save` tarball
# beside deploy/compose.yaml, deploy/mununu.toml and the customer's mununu.lic (docs/install.md
# § T1, deploy/README.md).
#
# Two stages: the binary is compiled on the pinned Rust toolchain against Debian trixie's libz3
# (4.13.3, z3-sys 0.13's floor — the same choice as docker/Dockerfile.dev); the runtime stage is
# trixie-slim + libz3 + ONE oss-cad-suite release (yosys with `read_slang`, slang, Verilator,
# btormc, pono, cvc5 — the tag docker/Dockerfile.sva pins, so the bundle verifies exactly what the
# e2e suite validates) + the UI's static build at /srv/mununu-ui. No sv2v: that is the dev-only
# differential oracle, never the product lift.
ARG RUST_VERSION=1.95
ARG OSS_CAD_SUITE_TAG=2026-08-24
ARG OSS_CAD_SUITE_DATE=20260824
# The tarball's sha256, checked before it is unpacked; a bump of TAG / DATE changes it too (the
# release's asset digest: `gh api repos/YosysHQ/oss-cad-suite-build/releases/tags/<TAG>
# --jq '.assets[] | select(.name|endswith("<DATE>.tgz") and contains("linux-x64")) | .digest'`).
ARG OSS_CAD_SUITE_SHA256=9d7f79975ef624e1119fc9690fd9b9839b67026925aff3e2a1192d861b8dbb7c

FROM rust:${RUST_VERSION}-slim-trixie AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        libz3-dev pkg-config build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
ENV CARGO_INCREMENTAL=0
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
ARG MUNUNU_BUILD_SHA=""
ARG MUNUNU_BUILD_DIRTY=""
ENV MUNUNU_BUILD_SHA=${MUNUNU_BUILD_SHA} MUNUNU_BUILD_DIRTY=${MUNUNU_BUILD_DIRTY}
# The API is mununu-core's `api` feature, which mununu-cli's dependency enables; the CLI crate
# itself has no features.
RUN cargo build --release -p mununu-cli

FROM debian:trixie-slim
ARG OSS_CAD_SUITE_TAG
ARG OSS_CAD_SUITE_DATE
ARG OSS_CAD_SUITE_SHA256
# libz3-4: the binary links it. curl: the healthcheck. g++ / make / perl: Verilator's
# counterexample replay compiles the generated C++ model at run time.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libz3-4 g++ make perl \
    && rm -rf /var/lib/apt/lists/*
# The suite, downloaded, checked against its pinned sha256 and unpacked into /opt in one layer
# (the tarball is removed in the same RUN, so the layer holds only the tree). Its binaries carry
# an rpath to their own lib tree, so only PATH is extended — no LD_LIBRARY_PATH, which would
# shadow the system libz3 the binary links.
RUN curl -fsSL -o /tmp/oss-cad-suite.tgz \
      "https://github.com/YosysHQ/oss-cad-suite-build/releases/download/${OSS_CAD_SUITE_TAG}/oss-cad-suite-linux-x64-${OSS_CAD_SUITE_DATE}.tgz" \
    && echo "${OSS_CAD_SUITE_SHA256}  /tmp/oss-cad-suite.tgz" | sha256sum -c - \
    && tar xzf /tmp/oss-cad-suite.tgz -C /opt \
    && rm /tmp/oss-cad-suite.tgz
ENV PATH="/opt/oss-cad-suite/bin:${PATH}"
LABEL io.github.mumunu-team.oss-cad-suite.tag="${OSS_CAD_SUITE_TAG}"
COPY --from=builder /build/target/release/mununu /usr/local/bin/mununu
# The UI build (scripts/bundle.sh puts it at deploy/ui-dist, gitignored) and the default
# deployment configuration; compose mounts the customer's mununu.toml and mununu.lic over these.
COPY deploy/ui-dist/ /srv/mununu-ui/
COPY deploy/mununu.toml /etc/mununu/mununu.toml
# The notices (THIRD_PARTY.md § "Bundled in the on-prem image", deploy/NOTICE.md): mununu's own
# licence texts; the suite's are already in /opt/oss-cad-suite/license and Debian's in
# /usr/share/doc/<package>/copyright; the UI's come with its build.
COPY LICENSE THIRD_PARTY.md deploy/NOTICE.md /usr/share/doc/mununu/
COPY LICENSES/ /usr/share/doc/mununu/LICENSES/
COPY docs/licensing.md /usr/share/doc/mununu/LICENSING.md
RUN useradd -m -u 1000 mununu && mkdir -p /work && chown mununu /work /etc/mununu
USER mununu
WORKDIR /work
VOLUME ["/work"]
HEALTHCHECK --interval=30s --timeout=5s CMD curl -sf http://localhost:8080/api/v1/health || exit 1
EXPOSE 8080
ENTRYPOINT ["mununu"]
CMD ["server", "--addr", "0.0.0.0:8080", "--config", "/etc/mununu/mununu.toml", "--ui-dir", "/srv/mununu-ui"]
