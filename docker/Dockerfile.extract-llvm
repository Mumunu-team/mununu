# Dockerfile for LLVM-based extraction frontend
# Includes LLVM 18, Clang, and SVF for C/C++/Rust extraction.
#
# This is a PLANNED image — SVF integration is not yet implemented.
# The image provides the toolchain; the extraction script will be added
# when the LLVM frontend is developed (Phase 6).
#
# LICENSE NOTE: SVF is GPL-3.0. This container runs SVF as a separate
# process (not linked into mununu). The output (.espec.json) is a data
# format. This is the "aggregation" exception — no copyleft applies to
# the mununu binaries or the output files.
#
# Build:
#   docker build -f docker/Dockerfile.extract-llvm -t mununu-extract-llvm .
#
# Usage (planned):
#   docker run --rm -v $(pwd):/work mununu-extract-llvm \
#     /work/config.json --source /work/connection.bc --output /work/spec.espec.json

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    llvm-18 \
    clang-18 \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# SVF would be installed here from release or built from source:
# RUN git clone https://github.com/SVF-tools/SVF.git /opt/svf && ...

RUN useradd -m appuser
USER appuser
WORKDIR /work

# Placeholder — extraction script will be added in Phase 6
ENTRYPOINT ["echo", "LLVM extraction frontend not yet implemented. See docs/adapters/extraction.md"]
