# Reproducible dev/test image for the mununu Rust workspace.
#
# Source is mounted at runtime, NOT baked in. Image rebuilds are rare;
# host edits are live. Same `docker run` line works locally and in CI.
#
# Build:
#   docker build -f docker/Dockerfile.dev -t mununu-dev .
#
# Create a named volume for cargo's target dir (so subsequent runs stay
# warm). The container writes there via CARGO_TARGET_DIR=/cargo-target
# rather than to the host's target/ — the host's local cargo workflow
# stays independent.
#   docker volume create mununu-target
#
# Ephemeral (one-off):
#   docker run --rm \
#     -v $(pwd):/work -v mununu-target:/cargo-target \
#     mununu-dev make ci
#
# Persistent (faster for iterative work):
#   docker run -d --name mununu-dev-c \
#     -v $(pwd):/work -v mununu-target:/cargo-target \
#     mununu-dev sleep infinity
#   docker exec mununu-dev-c make ci
#   docker stop mununu-dev-c && docker rm mununu-dev-c
#
# RTL counterexample validation (Verilator) is intentionally NOT in this
# image — use the sibling `hw-verif:latest` image from
# ../hw-verification-uba for that.

# Mirror of rust-toolchain.toml's `channel`. The workspace's
# rust-toolchain.toml is authoritative — rustup honors it at runtime
# and will download a different toolchain if this ARG drifts. Keep
# the two in lockstep on every bump.
ARG RUST_VERSION=1.95
FROM rust:${RUST_VERSION}-slim-bookworm

# Native deps required to build mununu's tree-sitter grammars + OpenSSL
# bindings + Z3 (mandatory since Phase A.4 step 4.2 — see
# `crates/mununu-core/Cargo.toml`). `python3` is used by helper scripts
# in scripts/. Single layer, --no-install-recommends, lists cleaned in
# the same RUN.
# `gdb` is here for mununu#543. A Rust stack overflow aborts with NO backtrace, so the only way to
# name the recursion site is a debugger catching the guard-page SIGSEGV before the abort. No mununu
# image carried a debugger, which made "send us a backtrace" an unreasonable ask of a consumer — that
# was our packaging gap, not theirs. Invoke it as:
#
#   docker run --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
#     -v "$(pwd)":/work -w /work mununu-dev \
#     gdb --batch -ex run -ex "bt 40" -ex "bt -20" \
#       --args ./mununu sv verify-auto <design> --frontend slang
#
# `bt 40` shows the recursion cycle, `bt -20` the entry path; the other ~40k frames are noise.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        libz3-dev \
        cmake \
        git \
        curl \
        ca-certificates \
        make \
        python3 \
        gdb \
    && rm -rf /var/lib/apt/lists/*

# rustfmt and clippy are normally bundled in the rust:* official images,
# but install explicitly so the image is robust to upstream changes.
RUN rustup component add rustfmt clippy

# cargo-nextest: the test runner `make test` selects when available. The
# image always carries it so CI's `make ci` always exercises the nextest
# path; doctests are invoked separately by `make test` via cargo test
# --doc (nextest does not run doctests).
RUN cargo install --locked cargo-nextest

# Use a container-side cargo target directory so the host's target/ is
# never touched by container builds. This avoids cargo cache thrashing
# when host and container use different toolchain hashes (e.g., the
# host's stable doesn't match the image's pinned RUST_VERSION). Mount
# a named volume here for cross-run caching:
#   docker run --rm -v $(pwd):/work -v mununu-target:/cargo-target ...
ENV CARGO_TARGET_DIR=/cargo-target
RUN mkdir -p /cargo-target

WORKDIR /work
