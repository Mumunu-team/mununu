{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Btor2JusticeEntry": {
      "description": "One justice set's verdict in [`Btor2VerifyJusticeResponse`].",
      "properties": {
        "decided_by": {
          "description": "The rung and engines that decided it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "index": {
          "description": "Position among the design's `justice` lines (0-based).",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "notes": {
          "description": "Abstention reasons, when a rung abstained.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outcome": {
          "description": "`\"holds\"` (no fair infinite path — HWMCC `uns`), `\"violated\"` (one exists — `sat`), `\"unknown\"`.",
          "type": "string"
        },
        "size": {
          "description": "Number of literals in the set.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "decided_by",
        "index",
        "notes",
        "outcome",
        "size"
      ],
      "type": "object"
    }
  },
  "description": "Response for `POST /api/v1/btor2/verify-liveness`. Mirrors [`crate::adapter::liveness_rescue::LivenessVerdict`].",
  "properties": {
    "converted_from_aiger": {
      "description": "With `justice`: whether the content was ASCII AIGER lowered to BTOR2.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "decided_by": {
      "description": "Portfolio engines that decided the reduced `bad`-reachability query.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "justice": {
      "description": "With `justice`: one entry per justice line (`decided_by` above is empty then).",
      "items": {
        "$ref": "#/definitions/Btor2JusticeEntry"
      },
      "type": "array"
    },
    "outcome": {
      "description": "Canonical property verdict — `\"holds\"` | `\"violated\"` | `\"unknown\"`, via [`crate::verdict::PropertyVerdict`].",
      "type": "string"
    },
    "property": {
      "description": "The reduced property, echoed for provenance: `AG((<request>) -> AF (<grant>))`.",
      "type": "string"
    }
  },
  "required": [
    "decided_by",
    "outcome",
    "property"
  ],
  "title": "Btor2VerifyLivenessResponse",
  "type": "object"
}
