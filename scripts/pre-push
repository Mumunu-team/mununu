#!/usr/bin/env bash
# Pre-push hook (2026-07-04) — TRIMMED local gate before push.
#
# History: pre-push previously ran the full `make ci`
# (`cargo test --workspace`, 1900+ tests, ~30–60 min wall-clock on this
# hardware, magnified by the backgrounded hook's lowered scheduling
# priority). That full test sweep is ~100% redundant with GitHub CI,
# which runs the same nextest workspace sweep on a dedicated, full-
# priority runner — and a feature branch cannot reach `main` without
# passing it.
#
# So the default pre-push now runs the parts that are CHEAP and catch
# the drift a per-crate pre-commit can miss:
#   - fmt --check              (workspace formatting)
#   - check --workspace        (cross-crate BUILD check — catches "core
#                               change broke cli's build" drift, without
#                               the cost of compiling every test binary)
#   - test --workspace --doc   (doctests — the class that has bitten us
#                               repeatedly; the `cargo test --tests`
#                               compilation phase does NOT cover them)
#   - cargo machete            (unused deps)
#
# What's dropped from the default:
#   - RUNNING the lib/integration test suite (`cargo test --workspace`).
#     CI owns it; pre-commit (scripts/pre-commit) already scope-tests the
#     touched crates + their downstream consumers on every commit.
#   - LINTING (clippy). pre-commit runs `clippy -p <touched> --all-targets`
#     (expanding to the whole workspace when mununu-core is touched), and
#     CI runs the full `clippy --workspace --all-targets` — a feature
#     branch cannot merge without it.
#
# Force the old full-workspace test sweep with:
#   MUNUNU_PREPUSH_FULL=1 git push
#
# To bypass entirely (rare; e.g. re-pushing a SHA the hook already
# validated after a silent-upload, or an emergency hotfix), use
# `git push --no-verify`. The user must authorize the bypass per
# CLAUDE.md's Git Operations section.
#
# Docs-only pushes (2026-11-09). When nothing in the pushed range changes
# what cargo builds — only Markdown, the agents and skills under .claude,
# CI workflows, scripts, Docker files — the compile steps below prove
# nothing the remote's `main` has not already proved for the identical
# Rust tree, and on this host they are the heavy workload the
# hook-serialisation rule (CLAUDE.md §CI Requirements) says not to start
# beside another agent's build. Such a push runs fmt + machete only. The
# detector ships with its negative control: `MUNUNU_PREPUSH_SELFTEST=1
# scripts/pre-push` must report a Rust path as Rust-bearing and a docs
# path as not, and that self-test runs first on every real push, so a
# broken detector fails the push instead of skipping the checks (C3).

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# A path is Rust-bearing when changing it can change what `cargo check` /
# `cargo test --doc` compile: crate sources and manifests, the lock file,
# the toolchain pin, cargo and nextest config, the root `tests/` tree.
rust_bearing() {
    grep -qE '^(crates/|Cargo\.toml$|Cargo\.lock$|rust-toolchain\.toml$|\.cargo/|\.config/|tests/|build\.rs$)'
}

prepush_selftest() {
    printf 'crates/mununu-core/src/lib.rs\n' | rust_bearing \
        || { echo "pre-push self-test FAILED: a crate source was not seen as Rust-bearing" >&2; return 1; }
    printf 'Cargo.lock\n' | rust_bearing \
        || { echo "pre-push self-test FAILED: Cargo.lock was not seen as Rust-bearing" >&2; return 1; }
    if printf '.claude/agents/x.md\ndocs/a.md\nscripts/pre-push\n.github/workflows/ci.yml\n' | rust_bearing; then
        echo "pre-push self-test FAILED: a docs-only list was seen as Rust-bearing" >&2; return 1
    fi
    echo "pre-push self-test ok (control: Rust path detected, docs-only list not)"
}

if [ "${MUNUNU_PREPUSH_SELFTEST:-}" = "1" ]; then
    prepush_selftest
    exit $?
fi

# A checkout whose root has no Cargo.toml — in this repository the gh-pages
# site branch — has nothing for cargo to check; the detector and the fmt /
# machete steps below assume a workspace and would fail on the missing
# manifest, never on the pushed change (2026-11-12). Such a push passes.
if [ ! -f Cargo.toml ]; then
    echo "Pre-push: no Cargo.toml at the repository root (a non-Rust branch such as gh-pages); nothing for cargo to check."
    exit 0
fi

if [ "${MUNUNU_PREPUSH_FULL:-}" = "1" ]; then
    echo "Pre-push (FULL): MUNUNU_PREPUSH_FULL=1 — running full-workspace make ci..."
    make ci
    echo "Pre-push: checking for unused dependencies (cargo machete)..."
    cargo machete
    echo "All pre-push checks passed (full sweep)."
    exit 0
fi

# The control first (see the header): a detector that cannot tell a Rust
# path from a docs path must fail the push, never skip the checks.
prepush_selftest

# Collect every file the pushed ranges change. The hook reads
# `<local ref> <local sha> <remote ref> <remote sha>` per ref on stdin; a
# new branch has an all-zero remote sha and is measured against
# origin/main's merge-base. No stdin (the script run by hand) or no
# resolvable base → conservative: treat the push as Rust-bearing.
PUSHED_FILES=""
RANGE_KNOWN=0
zero='0000000000000000000000000000000000000000'
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" = "$zero" ] && continue            # a branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
    else
        base="$remote_sha"
    fi
    if [ -z "$base" ]; then RANGE_KNOWN=0; break; fi
    RANGE_KNOWN=1
    PUSHED_FILES="$PUSHED_FILES
$(git diff --name-only "$base" "$local_sha")"
done

if [ "$RANGE_KNOWN" = "1" ] && ! printf '%s\n' "$PUSHED_FILES" | rust_bearing; then
    echo "Pre-push: no Rust-bearing path in the pushed range (docs / agents / CI / scripts only)."
    echo "Pre-push: cargo fmt --check (workspace)..."
    cargo fmt --all -- --check
    echo "Pre-push: checking for unused dependencies (cargo machete)..."
    cargo machete
    echo "All pre-push checks passed (docs-only push: compile steps skipped; CI runs the full gate)."
    exit 0
fi

echo "Pre-push: cargo fmt --check (workspace)..."
cargo fmt --all -- --check

# Cross-crate BUILD check (not lint). `check --workspace` compiles every
# crate's lib+bins for type-checking — catching the "a change in
# mununu-core broke mununu-cli's build" drift a per-crate pre-commit can
# miss — WITHOUT the cost of `--all-targets` (which cold-compiles every
# integration-test binary just to look at it, ~13 min on this hardware).
# Lint is already covered: pre-commit runs `clippy -p <touched>
# --all-targets` (expanding to the whole workspace when mununu-core is
# touched), and CI runs the full `clippy --workspace --all-targets`.
echo "Pre-push: cargo check --workspace (cross-crate build)..."
cargo check --workspace

echo "Pre-push: cargo test --workspace --doc (doctests)..."
cargo test --workspace --doc

echo "Pre-push: checking for unused dependencies (cargo machete)..."
cargo machete

echo "All pre-push checks passed (trimmed; full lib/integration test suite runs in CI)."
echo "Force the full local sweep with MUNUNU_PREPUSH_FULL=1 git push."
