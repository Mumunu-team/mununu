// Dual-condition start example: an industrial workcell where the assembly machine may enter
// the Running state only when both the safety gate is closed and the operator panel is marked
// ready. The machine transition uses a label set containing both `gate_closed` and
// `operator_ready`, illustrating multi-element labels in the CLTS representation.
context dual_condition_start {
    alphabet {
        label gate_closed;
        label gate_open;
        label operator_ready;
        label operator_reset;
        label stop;
    }

    automata {
        automaton SafetyGate {
            controllable {
                label gate_closed;
                label gate_open;
            }

            states {
                state Open initial;
                state Closed;
            }
            transitions {
                transition Open -> Closed on label gate_closed;
                transition Closed -> Open on label gate_open;
            }
        }

        automaton OperatorPanel {
            controllable {
                label operator_ready;
                label operator_reset;
            }

            states {
                state Idle initial;
                state Ready;
            }
            transitions {
                transition Idle -> Ready on label operator_ready;
                transition Ready -> Idle on label operator_reset;
            }
        }

        automaton AssemblyMachine {
            controllable {
                label stop;
            }

            states {
                state Idle initial;
                state Running;
            }
            transitions {
                // One joint action: the gate closes and the operator marks ready together.
                transition Idle -> Running on {label gate_closed, label operator_ready};
                transition Running -> Idle on label stop;
            }
        }
    }

    composition {
        synchronous workcell {
            members [SafetyGate, OperatorPanel, AssemblyMachine];
        }
    }

    mu_formulas {
        // Safety: the composed system always remains in a valid state.
        formula safety_invariant {
            over workcell;
            body = nu X. ([] X);
        }

        // Reachability: the Running state is reachable in the composition.
        formula running_reachable {
            over AssemblyMachine;
            body = mu X. (Running || <> X);
        }

        // Reachability: the system can always return to Idle.
        formula idle_reachable {
            over AssemblyMachine;
            body = mu X. (Idle || <> X);
        }
    }
}
